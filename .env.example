# Public (browser) — required
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-side (SSR + server functions) — required
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="your-project-ref"

# Privileged server key — only needed if you use admin-only server code
SUPABASE_SERVICE_ROLE_KEY=""

# AI workspace (summaries, risk detection, task generation).
# Option A: Direct Google Gemini API Key
GEMINI_API_KEY=""
# Direct Gemini Model to use (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Option B: Lovable AI Gateway Key
LOVABLE_API_KEY=""

# Supabase direct connection string for running migrations
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:6543/postgres
SUPABASE_DB_URL=""

# Deployment target for the server build (vercel, netlify, node-server, cloudflare_module)
NITRO_PRESET="vercel"
